@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    ViewData["BodyClass"] = "page-account";
}

<section class="account-page" aria-labelledby="register-title">
    <h1 id="register-title" class="account-title">@ViewData["Title"]</h1>
    <div class="row g-4">
        <div class="col-md-5">
            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <h2 class="account-subtitle">Create a new account.</h2>
                <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email">Email</label>
                    <span asp-validation-for="Input.Email" class="field-error"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                    <label asp-for="Input.Password">Password</label>
                    <span asp-validation-for="Input.Password" class="field-error"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                    <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                    <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
                </div>
                <p class="form-hint form-hint--account">
                    Passwords need at least 6 characters, including an uppercase letter, a lowercase letter, a number and a symbol.
                </p>
                <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Register</button>
                <ul class="account-links">
                    <li><a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Already have an account? Log in</a></li>
                </ul>
            </form>
        </div>
        <div class="col-md-6 offset-md-1">
            <section aria-labelledby="external-register-title">
                <h2 id="external-register-title" class="account-subtitle account-subtitle--accent">Use another service to register.</h2>
                @if (Model.ExternalLogins.Count == 0)
                {
                    <p class="account-note">
                        There are no external authentication services configured. See this
                        <a href="https://go.microsoft.com/fwlink/?LinkID=532715" target="_blank" rel="noopener noreferrer">article about setting up this ASP.NET application to support logging in via external services</a>.
                    </p>
                }
                else
                {
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        @foreach (var provider in Model.ExternalLogins)
                        {
                            <button type="submit" class="btn btn-primary" name="provider" value="@provider.Name"
                                    title="Log in using your @provider.DisplayName account">@provider.DisplayName</button>
                        }
                    </form>
                }
                <div class="account-tip">
                    <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                    Once registered you are signed in straight away and can upload your AI images.
                </div>
            </section>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
