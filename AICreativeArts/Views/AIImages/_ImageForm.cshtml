@model AIImageFormViewModel
@inject Microsoft.Extensions.Options.IOptions<UploadOptions> UploadSettings
@{
    var isEdit = Model.Id > 0;
    var accept = ".jpg,.jpeg,.png,.gif,.webp,image/jpeg,image/png,image/gif,image/webp";
    var maxBytes = UploadSettings.Value.MaxFileBytes;
}

<div class="row g-4 image-form-row">
    <div class="col-md-8">
        <form id="image-form" class="image-form" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.Id.ToString() : null)" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            @if (isEdit)
            {
                <input type="hidden" asp-for="Id" />
            }

            <div class="form-field">
                <label asp-for="Prompt" class="form-label"></label>
                <textarea asp-for="Prompt" class="form-control" rows="5"
                          placeholder="Describe the prompt you gave the AI image generator"></textarea>
                <span asp-validation-for="Prompt" class="field-error"></span>
            </div>

            <div class="form-field">
                <label asp-for="ImageGenerator" class="form-label"></label>
                <input asp-for="ImageGenerator" class="form-control" list="generator-suggestions" autocomplete="off"
                       placeholder="e.g. Midjourney" />
                <datalist id="generator-suggestions">
                    <option value="Midjourney"></option>
                    <option value="Adobe Firefly"></option>
                    <option value="DALL-E 3"></option>
                    <option value="Stable Diffusion"></option>
                    <option value="Microsoft Designer"></option>
                    <option value="Leonardo AI"></option>
                    <option value="Ideogram"></option>
                    <option value="Google Imagen"></option>
                </datalist>
                <span asp-validation-for="ImageGenerator" class="field-error"></span>
            </div>

            <div class="form-field">
                <label asp-for="UploadDate" class="form-label"></label>
                <input asp-for="UploadDate" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" readonly
                       aria-describedby="readonly-hint" />
            </div>

            <div class="form-field">
                <label asp-for="Like" class="form-label"></label>
                <input asp-for="Like" class="form-control" readonly aria-describedby="readonly-hint" />
                <small id="readonly-hint" class="form-hint">Upload Date and Like are set automatically and cannot be changed here.</small>
            </div>

            <div class="form-field">
                <label asp-for="ImageFile" class="form-label"></label>
                @if (isEdit)
                {
                    <input asp-for="ImageFile" type="file" class="form-control" accept="@accept"
                           data-max-bytes="@maxBytes" data-preview="#image-preview-figure" aria-describedby="file-hint" />
                    <small id="file-hint" class="form-hint">Leave empty to keep the current image. JPG, PNG, GIF or WEBP, up to 5 MB.</small>
                }
                else
                {
                    <input asp-for="ImageFile" type="file" class="form-control" accept="@accept"
                           data-max-bytes="@maxBytes" data-preview="#image-preview-figure" aria-describedby="file-hint"
                           data-val="true" data-val-required="Please choose an image file to upload." />
                    <small id="file-hint" class="form-hint">JPG, PNG, GIF or WEBP, up to 5 MB.</small>
                }
                <span asp-validation-for="ImageFile" class="field-error"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-submit">
                <i class="fa-solid @(isEdit ? "fa-floppy-disk" : "fa-cloud-arrow-up")" aria-hidden="true"></i>
                @(isEdit ? "Save" : "Create")
            </button>
        </form>
    </div>

    <div class="col-md-4">
        <figure class="image-preview" id="image-preview-figure">
            @if (isEdit)
            {
                <img class="image-preview-img image-preview-default" src="@Url.UploadedImage(Model.CurrentFilename)"
                     alt="Current image" data-image-fallback />
            }
            else
            {
                @* The brief's "default image": an image slot you fill with your own picture. *@
                <image-slot key="@ImageLibrary.UploadPreview" class="image-preview-img image-preview-default" lazy="false" />
            }
            <img id="image-preview" class="image-preview-img image-preview-chosen" alt="Preview of the image you chose" hidden />
            <figcaption class="image-preview-caption" data-default-caption="@(isEdit ? "Current image" : "Image preview")">
                @(isEdit ? "Current image" : "Image preview")
            </figcaption>
        </figure>
    </div>
</div>

<p class="back-link-row">
    <a class="back-link" asp-action="Index"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back to List</a>
</p>
