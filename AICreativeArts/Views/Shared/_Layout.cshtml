@inject AICreativeArts.Services.IMediaLibrary Media
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@(ViewData["Description"] ?? "AI Unmasked examines the harm generative AI is doing to the creative arts: training without consent, lost livelihoods and convincing fakes, and how artists can protect their work.")" />
    <meta name="theme-color" content="#0b0b0d" />
    <title>@ViewData["Title"] - AI Unmasked</title>
    @if (Media.HasFile(ImageLibrary.Favicon))
    {
        <link rel="icon" href="~/favicon.ico" asp-append-version="true" />
    }
    <link rel="preload" href="~/lib/fonts/anton-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/lib/fonts/montserrat-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/fontawesome.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/brands.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/solid.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@{
    // Background image slots are only referenced by the CSS once their files exist.
    var backgroundClasses = string.Join(' ', new[]
    {
        Media.HasFile(ImageLibrary.HeroBackground) ? "has-hero-image" : null,
        Media.HasFile(ImageLibrary.SectionBackground) ? "has-section-image" : null,
    }.Where(c => c is not null));
}
<body class="@(ViewData["BodyClass"] ?? "page-default") @backgroundClasses">
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
        <nav class="navbar navbar-expand-sm navbar-dark site-navbar" aria-label="Main">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-triangle-exclamation brand-icon" aria-hidden="true"></i>
                    <span class="brand-text" data-text="AI Unmasked">AI Unmasked</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-menu"
                        aria-controls="main-menu" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="main-menu">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" nav-active="Home/Index" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" nav-active="AIImages/*" asp-area="" asp-controller="AIImages" asp-action="Index">AI Images</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" nav-active="Home/ArtistShield" asp-area="" asp-controller="Home" asp-action="ArtistShield">Artist Shield</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" nav-active="Home/Contact" asp-area="" asp-controller="Home" asp-action="Contact">Contact</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main id="main-content" class="site-main" tabindex="-1">
        <partial name="_SiteToasts" />
        @RenderBody()
    </main>

    <footer class="site-footer">
        <nav class="footer-nav" aria-label="Footer">
            <ul class="footer-links">
                <li><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a asp-area="" asp-controller="AIImages" asp-action="Index">AI Images</a></li>
                <li><a asp-area="" asp-controller="Home" asp-action="ArtistShield">Artist Shield</a></li>
                <li><a asp-area="" asp-controller="Home" asp-action="Contact">Contact</a></li>
            </ul>
            <ul class="social-links">
                <li>
                    <a class="social-icon social-google" href="https://artsandculture.google.com/" target="_blank" rel="noopener noreferrer"
                       aria-label="Google Arts &amp; Culture (opens in a new tab)"><i class="fa-brands fa-google" aria-hidden="true"></i></a>
                </li>
                <li>
                    <a class="social-icon social-youtube" href="https://www.youtube.com/" target="_blank" rel="noopener noreferrer"
                       aria-label="YouTube (opens in a new tab)"><i class="fa-brands fa-youtube" aria-hidden="true"></i></a>
                </li>
                <li>
                    <a class="social-icon social-twitter" href="https://x.com/" target="_blank" rel="noopener noreferrer"
                       aria-label="X, formerly Twitter (opens in a new tab)"><i class="fa-brands fa-twitter" aria-hidden="true"></i></a>
                </li>
                <li>
                    <a class="social-icon social-facebook" href="https://www.facebook.com/" target="_blank" rel="noopener noreferrer"
                       aria-label="Facebook (opens in a new tab)"><i class="fa-brands fa-facebook-f" aria-hidden="true"></i></a>
                </li>
                <li>
                    <a class="social-icon social-linkedin" href="https://www.linkedin.com/" target="_blank" rel="noopener noreferrer"
                       aria-label="LinkedIn (opens in a new tab)"><i class="fa-brands fa-linkedin-in" aria-hidden="true"></i></a>
                </li>
            </ul>
        </nav>
        <p class="footer-note">AI Unmasked &middot; A student project about the harm generative AI can do to the creative arts.</p>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
