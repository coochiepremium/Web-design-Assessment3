@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<ul class="navbar-nav navbar-account">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage your account">
            <i class="fa-solid fa-circle-user account-icon" aria-hidden="true"></i>
            <span class="account-greeting">Hello </span><span class="account-name">@User.Identity?.Name</span><span class="account-greeting">!</span>
            @if (User.IsInRole(AICreativeArts.Authorization.Roles.Admin))
            {
                <span class="role-badge">Admin</span>
            }
        </a>
    </li>
    <li class="nav-item">
        <form class="logout-form" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
            <button type="submit" class="nav-link btn btn-link">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
}
</ul>
