@{
    var message = TempData["SiteMessage"] as string;
    var error = TempData["SiteError"] as string;
}
@if (!string.IsNullOrEmpty(message) || !string.IsNullOrEmpty(error))
{
    <div class="toast-stack" aria-live="polite" aria-atomic="true">
        @if (!string.IsNullOrEmpty(message))
        {
            <div class="toast show site-toast site-toast--success" role="status">
                <div class="toast-body">
                    <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                    <span>@message</span>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="toast show site-toast site-toast--error" role="alert">
                <div class="toast-body">
                    <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                    <span>@error</span>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
    </div>
}
