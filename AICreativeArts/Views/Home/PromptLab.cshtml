@{
    ViewData["Title"] = "Prompt Lab";
    ViewData["BodyClass"] = "page-lab";
    ViewData["Description"] = "Build a detailed prompt for an AI image generator and explore a short history of creative AI.";
    var createUrl = Url.Action("Create", "AIImages");
}

<section class="hero hero--lab" aria-labelledby="lab-title">
    <h1 id="lab-title" class="hero-title hero-title--stroked">Prompt Lab</h1>
    <p class="hero-text">
        Great AI art starts with a great prompt. Mix a subject, an art style, lighting, colours, mood and framing,
        and watch your prompt build itself. Copy it into your favourite image generator, then share the result in our gallery.
    </p>
</section>

<div class="parallax-section lab-section">
    <div class="lab-grid">
        <section class="lab-panel lab-builder" aria-labelledby="builder-title">
            <h2 id="builder-title" class="lab-heading">
                <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> Build your prompt
            </h2>

            <div class="lab-field">
                <label for="custom-subject" class="lab-label">Your own subject <span class="lab-optional">(optional)</span></label>
                <input id="custom-subject" type="text" class="form-control lab-input" maxlength="120" autocomplete="off"
                       placeholder="e.g. a violinist made of autumn leaves" />
            </div>

            @foreach (var group in PromptLabContent.Groups)
            {
                <fieldset class="chip-group" data-group="@group.Key">
                    <legend class="lab-label">
                        <i class="fa-solid @group.Icon" aria-hidden="true"></i> @group.Title
                    </legend>
                    <div class="chip-list">
                        @foreach (var option in group.Options)
                        {
                            <button type="button" class="chip" data-value="@option.Value" aria-pressed="false">@option.Label</button>
                        }
                    </div>
                </fieldset>
            }
        </section>

        <section class="lab-panel lab-output" aria-labelledby="output-title">
            <h2 id="output-title" class="lab-heading">
                <i class="fa-solid fa-feather-pointed" aria-hidden="true"></i> Your prompt
            </h2>

            <p id="prompt-output" class="prompt-output is-empty" aria-live="polite">
                Choose some options (or type your own subject) to start building your prompt.
            </p>

            <div class="prompt-meter" aria-hidden="true">
                <span class="meter-step"></span><span class="meter-step"></span><span class="meter-step"></span>
                <span class="meter-step"></span><span class="meter-step"></span><span class="meter-step"></span>
            </div>
            <p class="prompt-stats">
                Detail: <strong id="prompt-strength">Empty</strong>
                <span class="prompt-divider" aria-hidden="true">|</span>
                <span id="prompt-words">0</span> words
            </p>

            <div class="lab-actions">
                <button id="prompt-random" type="button" class="btn btn-warning btn-sm">
                    <i class="fa-solid fa-shuffle" aria-hidden="true"></i> Surprise me
                </button>
                <button id="prompt-copy" type="button" class="btn btn-primary btn-sm" disabled>
                    <i class="fa-solid fa-copy" aria-hidden="true"></i> Copy
                </button>
                <button id="prompt-save" type="button" class="btn btn-success btn-sm" disabled>
                    <i class="fa-solid fa-bookmark" aria-hidden="true"></i> Save
                </button>
                <button id="prompt-clear" type="button" class="btn btn-outline-light btn-sm">
                    <i class="fa-solid fa-eraser" aria-hidden="true"></i> Clear
                </button>
            </div>
            <p id="prompt-feedback" class="prompt-feedback" role="status"></p>

            <a id="prompt-upload" class="btn btn-upload" href="@createUrl" data-base-href="@createUrl">
                <i class="fa-solid fa-cloud-arrow-up" aria-hidden="true"></i> Upload an image made with this prompt
            </a>

            <h3 class="saved-heading">Saved prompts</h3>
            <ol id="saved-prompts" class="saved-prompts"></ol>
            <p id="saved-empty" class="saved-empty">Nothing saved yet. Saved prompts stay in this browser only.</p>
        </section>
    </div>

    <section class="timeline-section" aria-labelledby="timeline-title">
        <h2 id="timeline-title" class="upload-title">A Short History of Creative AI</h2>
        <ol class="timeline">
            @foreach (var entry in PromptLabContent.Timeline)
            {
                <li class="timeline-item reveal-on-view reveal-once">
                    <span class="timeline-year">@entry.Year</span>
                    <div class="timeline-card">
                        <h3 class="timeline-title">@entry.Title</h3>
                        <p class="timeline-text">@entry.Text</p>
                        <a class="timeline-source" href="@entry.SourceUrl" target="_blank" rel="noopener noreferrer">
                            Source<span class="visually-hidden">: @entry.Title (opens in a new tab)</span>
                        </a>
                    </div>
                </li>
            }
        </ol>
    </section>
</div>
