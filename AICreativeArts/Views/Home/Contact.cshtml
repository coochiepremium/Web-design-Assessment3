@model SiteOptions
@inject AICreativeArts.Services.IMediaLibrary Media
@{
    ViewData["Title"] = "Contact & About";
    ViewData["BodyClass"] = "page-contact";
    ViewData["Description"] = "Contact details, information about the AI Unmasked website and credits for every image, icon, font and text source.";
    var slots = Media.All();
}

<section class="hero hero--contact" aria-labelledby="contact-title">
    <h1 id="contact-title" class="hero-title">Contact &amp; About</h1>
    <background-slot-note key="@ImageLibrary.HeroBackground" />

    <div class="container-fluid contact-container">
        <div class="row g-4 g-xl-5 contact-row">
            <div class="col-12 col-md-4 d-flex">
                <section class="contact-card" aria-labelledby="contact-us-title">
                    <h1 id="contact-us-title" class="contact-heading">Contact Us</h1>
                    <p class="contact-text">
                        This website is developed by @Model.DeveloperName
                        <br />To get in contact please email
                        <a href="mailto:@Model.ContactEmail">@Model.ContactEmail</a>
                    </p>
                </section>
            </div>

            <div class="col-12 col-md-4 d-flex">
                <section class="contact-card" aria-labelledby="about-us-title">
                    <h1 id="about-us-title" class="contact-heading">About Us</h1>
                    <p class="contact-text">
                        This website examines the harmful side of Artificial Intelligence in the Creative Arts &ndash;
                        training on art without consent, lost work for creative people and convincing fakes &ndash;
                        and shows artists how to protect their work. It was created as partial fulfillment of the
                        assessment requirements of Web Design and Programming at the University of Canberra.
                        <br />This site is built on the ASP.NET CORE MVC framework with Entity Framework Core, and employs
                        Bootstrap, Flexbox and CSS Grid responsive design techniques.
                    </p>
                </section>
            </div>

            <div class="col-12 col-md-4 d-flex">
                <section class="contact-card" aria-labelledby="copyright-title">
                    <h1 id="copyright-title" class="contact-heading">Copyright</h1>
                    <p class="contact-text">
                        Every image on this website is credited to its creator, source and licence in the
                        <a href="#image-credits">image credits</a> below.
                        <br />The icons for the footer are from
                        <a href="https://fontawesome.com/" target="_blank" rel="noopener noreferrer">Font Awesome</a>.
                        <br />The Anton, Montserrat, Lato, Oxygen and Niconne fonts are from
                        <a href="https://fonts.google.com/" target="_blank" rel="noopener noreferrer">Google Fonts</a>.
                        <br />Responsive layout by <a href="https://getbootstrap.com/" target="_blank" rel="noopener noreferrer">Bootstrap</a>.
                    </p>
                </section>
            </div>
        </div>

        <section id="image-credits" class="contact-card credits-card" aria-labelledby="credits-title">
            <h1 id="credits-title" class="contact-heading">Image Credits</h1>
            <p class="contact-text">Where each image on this website came from.</p>
            <ul class="credits-list">
                @foreach (var item in slots)
                {
                    <li class="credit-item @(item.HasFile ? "" : "credit-item--missing")">
                        <span class="credit-where">@item.Slot.UsedOn</span>
                        @if (!item.HasFile)
                        {
                            <span class="credit-status credit-status--missing">
                                <i class="fa-solid fa-image" aria-hidden="true"></i> Image not added yet &ndash; <code>wwwroot/@item.Slot.File</code>
                            </span>
                        }
                        @if (item.Credit.IsComplete)
                        {
                            <span class="credit-text">
                                @item.Credit.Creator, @item.Credit.Source@(string.IsNullOrWhiteSpace(item.Credit.Licence) ? "" : $" ({item.Credit.Licence})")
                                @if (item.Credit.HasLink)
                                {
                                    <a href="@item.Credit.Url" target="_blank" rel="noopener noreferrer">View original<span class="visually-hidden"> image for @item.Slot.UsedOn (opens in a new tab)</span></a>
                                }
                            </span>
                        }
                        else
                        {
                            <span class="credit-status credit-status--reference">
                                <i class="fa-solid fa-quote-left" aria-hidden="true"></i> Reference needed &ndash; add it under
                                <code>ImageCredits:@item.Slot.Key</code> in appsettings.json
                            </span>
                        }
                    </li>
                }
            </ul>
        </section>

        <section class="contact-card sources-card" aria-labelledby="sources-title">
            <h1 id="sources-title" class="contact-heading">Sources</h1>
            <p class="contact-text">
                The case files, quiz, protection checklist and timeline were researched and written in our own words using these sources:
            </p>
            <ul class="sources-list">
                @foreach (var (title, url) in SiteContent.TextSources)
                {
                    <li><a href="@url" target="_blank" rel="noopener noreferrer">@title</a></li>
                }
            </ul>
        </section>
    </div>
</section>
