@model IReadOnlyList<CreativeTool>

@* site.js builds the hover caption for each tile from its data-* attributes. *@
<div class="tool-tiles">
    @foreach (var tool in Model)
    {
        <a class="tool-tile" href="@tool.Url" target="_blank" rel="noopener noreferrer"
           data-hover-text="@tool.HoverText" data-hover-source="@tool.Source"
           aria-label="@tool.Name: @tool.HoverText (@tool.Source). Opens the @tool.Name website in a new tab.">
            <img class="tool-tile-image" src="@Url.Content(tool.ImagePath)" alt="@tool.Name" width="600" height="600" loading="lazy" />
        </a>
    }
</div>
